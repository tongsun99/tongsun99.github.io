f55\u4f7f\u7528\u672c\u535a\u5ba2 - 2025-02-19</li> </ul> <p>\ud83d\udca1 \u4f7f\u7528\u9875\u9762\u9876\u90e8\u7684\u641c\u7d22\u529f\u80fd\u5feb\u901f\u67e5\u627e\u5185\u5bb9\uff0c\u6216\u8bbf\u95ee\u6807\u7b7e\u9875\u6309\u6807\u7b7e\u6d4f\u89c8\u3002</p>"},{"location":"notes/how-to-use/","title":"\u5982\u4f55\u4f7f\u7528\u672c\u535a\u5ba2","text":"<p>\u6587\u7ae0\u4fe1\u606f</p> <p>\u53d1\u5e03\u65f6\u95f4: 2025-02-19 \u6807\u7b7e: mkdocs</p> <p>\u672c\u535a\u5ba2\u4f7f\u7528 MkDocs \u548c Material for MkDocs \u4e3b\u9898\u6784\u5efa\uff0c\u5df2\u5b9e\u73b0\u5b8c\u5168\u81ea\u52a8\u5316\u7684\u6587\u7ae0\u7ba1\u7406\u3002\u4f60\u53ea\u9700\u8981\u521b\u5efa\u7b26\u5408\u683c\u5f0f\u7684 Markdown \u6587\u4ef6\uff0c\u6240\u6709\u7684\u5217\u8868\u3001\u7d22\u5f15\u548c\u5bfc\u822a\u90fd\u4f1a\u81ea\u52a8\u66f4\u65b0\u3002</p>","tags":["mkdocs"]},{"location":"notes/how-to-use/#_2","title":"\u6dfb\u52a0\u65b0\u7b14\u8bb0\u7684\u6b65\u9aa4","text":"","tags":["mkdocs"]},{"location":"notes/how-to-use/#1-markdown","title":"1. \u521b\u5efa Markdown \u6587\u4ef6","text":"<p>\u5728 <code>docs/notes/</code> \u76ee\u5f55\u4e0b\u521b\u5efa\u4e00\u4e2a\u65b0\u7684 <code>.md</code> \u6587\u4ef6\uff0c\u4f8b\u5982 <code>my-article.md</code></p> <p>\u5efa\u8bae\u4f7f\u7528\u5c0f\u5199\u5b57\u6bcd\u548c\u8fde\u5b57\u7b26\u4f5c\u4e3a\u6587\u4ef6\u540d\u3002</p>","tags":["mkdocs"]},{"location":"notes/how-to-use/#2-yaml","title":"2. \u6dfb\u52a0 YAML \u5143\u6570\u636e","text":"<p>\u5728\u6587\u4ef6\u9876\u90e8\u6dfb\u52a0 YAML frontmatter\uff08\u5fc5\u9700\uff09\uff1a</p> <pre><code>---\ntitle: \u4f60\u7684\u6587\u7ae0\u6807\u9898\ndate: 2025-02-19\ntags:\n  - \u6807\u7b7e1\n  - \u6807\u7b7e2\n---\n</code></pre> <p>\u5fc5\u9700\u5b57\u6bb5</p> <ul> <li><code>title</code>: \u6587\u7ae0\u6807\u9898\uff08\u5fc5\u9700\uff09</li> <li><code>date</code>: \u53d1\u5e03\u65e5\u671f\uff0c\u683c\u5f0f\u4e3a <code>YYYY-MM-DD</code>\uff08\u5fc5\u9700\uff09</li> <li><code>tags</code>: \u6807\u7b7e\u5217\u8868\uff08\u53ef\u9009\uff09</li> </ul>","tags":["mkdocs"]},{"location":"notes/how-to-use/#3","title":"3. \u7f16\u5199\u5185\u5bb9","text":"<p>\u63a8\u8350\u4f7f\u7528\u4ee5\u4e0b\u7ed3\u6784\uff1a</p> <pre><code># \u6587\u7ae0\u6807\u9898\n\n!!! info \"\u6587\u7ae0\u4fe1\u606f\"\n    **\u53d1\u5e03\u65f6\u95f4**: 2025-02-19\n    **\u6807\u7b7e**: \u6807\u7b7e1, \u6807\u7b7e2\n\n## \u7ae0\u8282\u6807\u9898\n\n\u4f60\u7684\u5185\u5bb9...\n\n### \u5b50\u7ae0\u8282\n\n\u66f4\u591a\u5185\u5bb9...\n</code></pre>","tags":["mkdocs"]},{"location":"notes/how-to-use/#4","title":"4. \u9884\u89c8\u548c\u6784\u5efa","text":"<pre><code># \u672c\u5730\u9884\u89c8\uff08\u5e26\u5b9e\u65f6\u5237\u65b0\uff09\nmkdocs serve\n\n# \u6784\u5efa\u751f\u4ea7\u7248\u672c\nmkdocs build\n</code></pre> <p>\u5c31\u8fd9\u6837\uff01\u6240\u6709\u7d22\u5f15\u4f1a\u81ea\u52a8\u66f4\u65b0\u3002</p>","tags":["mkdocs"]},{"location":"notes/how-to-use/#_3","title":"\u81ea\u52a8\u5316\u529f\u80fd","text":"<p>\u672c\u535a\u5ba2\u7684\u4ee5\u4e0b\u529f\u80fd\u90fd\u662f\u5168\u81ea\u52a8\u7684\uff0c\u65e0\u9700\u624b\u52a8\u7ef4\u62a4\uff1a</p>","tags":["mkdocs"]},{"location":"notes/how-to-use/#_4","title":"\ud83d\uddc2\ufe0f \u5de6\u4fa7\u5bfc\u822a\u680f","text":"<ul> <li>\u81ea\u52a8\u626b\u63cf\u6240\u6709\u7b14\u8bb0\u6587\u4ef6</li> <li>\u6309\u6807\u9898\u7684\u62fc\u97f3/\u5b57\u6bcd\u5e8f\u81ea\u52a8\u6392\u5e8f</li> <li>\u4e2d\u6587\u6807\u9898\u6309\u62fc\u97f3\u6392\u5e8f\uff0c\u82f1\u6587\u6807\u9898\u6309\u5b57\u6bcd\u6392\u5e8f</li> </ul>","tags":["mkdocs"]},{"location":"notes/how-to-use/#_5","title":"\ud83d\udcc5 \u9996\u9875\"\u6700\u8fd1\u66f4\u65b0\"","text":"<ul> <li>\u81ea\u52a8\u663e\u793a\u6700\u65b0\u7684 10 \u7bc7\u6587\u7ae0</li> <li>\u6309\u53d1\u5e03\u65e5\u671f\u5012\u5e8f\u6392\u5217</li> </ul>","tags":["mkdocs"]},{"location":"notes/how-to-use/#_6","title":"\ud83d\uddd3\ufe0f \u65f6\u95f4\u5f52\u6863","text":"<ul> <li>\u6309\u5e74\u4efd\u548c\u6708\u4efd\u81ea\u52a8\u5206\u7ec4</li> <li>\u5728\u7b14\u8bb0\u5217\u8868\u9875\u9762\u663e\u793a</li> </ul>","tags":["mkdocs"]},{"location":"notes/how-to-use/#_7","title":"\ud83c\udff7\ufe0f \u6807\u7b7e\u7cfb\u7edf","text":"<ul> <li>\u81ea\u52a8\u6536\u96c6\u6240\u6709\u6587\u7ae0\u7684\u6807\u7b7e</li> <li>\u6807\u7b7e\u53ef\u70b9\u51fb\uff0c\u8df3\u8f6c\u5230\u8be5\u6807\u7b7e\u7684\u6240\u6709\u6587\u7ae0</li> <li>\u6807\u7b7e\u7d22\u5f15\u9875\u81ea\u52a8\u751f\u6210</li> </ul>","tags":["mkdocs"]},{"location":"notes/how-to-use/#_8","title":"\ud83d\udd0d \u641c\u7d22\u529f\u80fd","text":"<ul> <li>\u652f\u6301\u4e2d\u82f1\u6587\u5168\u6587\u641c\u7d22</li> <li>\u81ea\u52a8\u7d22\u5f15\u6240\u6709\u6587\u7ae0\u5185\u5bb9</li> </ul>","tags":["mkdocs"]},{"location":"notes/how-to-use/#markdown","title":"\u652f\u6301\u7684 Markdown \u6269\u5c55","text":"","tags":["mkdocs"]},{"location":"notes/how-to-use/#_9","title":"\u4ee3\u7801\u9ad8\u4eae","text":"<pre><code>def greet(name: str) -&gt; str:\n    \"\"\"\u95ee\u5019\u51fd\u6570\"\"\"\n    return f\"Hello, {name}!\"\n\nprint(greet(\"World\"))\n</code></pre>","tags":["mkdocs"]},{"location":"notes/how-to-use/#_10","title":"\u63d0\u793a\u6846","text":"<p>\u63d0\u793a</p> <p>\u8fd9\u662f\u4e00\u4e2a\u63d0\u793a\u6846</p> <p>\u6280\u5de7</p> <p>\u8fd9\u662f\u4e00\u4e2a\u6280\u5de7\u63d0\u793a</p> <p>\u8b66\u544a</p> <p>\u8fd9\u662f\u4e00\u4e2a\u8b66\u544a</p> <p>\u5371\u9669</p> <p>\u8fd9\u662f\u4e00\u4e2a\u5371\u9669\u8b66\u544a</p>","tags":["mkdocs"]},{"location":"notes/how-to-use/#_11","title":"\u4efb\u52a1\u5217\u8868","text":"<ul> <li> \u5df2\u5b8c\u6210\u7684\u4efb\u52a1</li> <li> \u672a\u5b8c\u6210\u7684\u4efb\u52a1</li> <li> \u53e6\u4e00\u4e2a\u4efb\u52a1</li> </ul>","tags":["mkdocs"]},{"location":"notes/how-to-use/#_12","title":"\u8868\u683c","text":"\u529f\u80fd \u8bf4\u660e \u72b6\u6001 \u81ea\u52a8\u5bfc\u822a \u6309\u62fc\u97f3/\u5b57\u6bcd\u5e8f\u6392\u5e8f \u2705 \u6807\u7b7e\u7cfb\u7edf \u81ea\u52a8\u6536\u96c6\u548c\u7d22\u5f15 \u2705 \u641c\u7d22\u529f\u80fd \u4e2d\u82f1\u6587\u5168\u6587\u641c\u7d22 \u2705","tags":["mkdocs"]},{"location":"notes/how-to-use/#_13","title":"\u63d2\u5165\u56fe\u7247","text":"<p>\u5c06\u56fe\u7247\u653e\u5728 <code>docs/images/</code> \u76ee\u5f55\u4e0b\uff0c\u7136\u540e\u5728 Markdown \u4e2d\u5f15\u7528\uff1a</p> <pre><code>![\u56fe\u7247\u63cf\u8ff0](../images/example.svg)\n</code></pre> <p>\u6548\u679c\u5982\u4e0b\uff1a</p> <p></p> <p>\u4f60\u4e5f\u53ef\u4ee5\u6307\u5b9a\u56fe\u7247\u5927\u5c0f\u548c\u5bf9\u9f50\u65b9\u5f0f\uff1a</p> <pre><code>&lt;figure markdown&gt;\n  ![\u793a\u4f8b\u56fe\u7247](../images/example.svg){ width=\"300\" }\n  &lt;figcaption&gt;\u56fe\u7247\u8bf4\u660e\u6587\u5b57&lt;/figcaption&gt;\n&lt;/figure&gt;\n</code></pre> <p>\u56fe\u7247\u5efa\u8bae</p> <ul> <li>\u5c06\u56fe\u7247\u7edf\u4e00\u653e\u5728 <code>docs/images/</code> \u76ee\u5f55</li> <li>\u4f7f\u7528\u6709\u610f\u4e49\u7684\u6587\u4ef6\u540d\uff0c\u5982 <code>architecture-diagram.png</code></li> <li>\u652f\u6301\u7684\u683c\u5f0f\uff1aPNG\u3001JPG\u3001SVG\u3001GIF</li> <li>SVG \u683c\u5f0f\u9002\u5408\u56fe\u8868\u548c\u56fe\u6807\uff0c\u4f53\u79ef\u5c0f\u4e14\u6e05\u6670</li> </ul>","tags":["mkdocs"]},{"location":"notes/how-to-use/#_14","title":"\u6587\u7ae0\u6a21\u677f","text":"<p>\u5c06\u4ee5\u4e0b\u5185\u5bb9\u590d\u5236\u5230\u65b0\u6587\u4ef6\u4e2d\u4f5c\u4e3a\u8d77\u70b9\uff1a</p> <pre><code>---\ntitle: \u6587\u7ae0\u6807\u9898\ndate: 2025-02-19\ntags:\n  - \u6807\u7b7e1\n  - \u6807\u7b7e2\n---\n\n# \u6587\u7ae0\u6807\u9898\n\n!!! info \"\u6587\u7ae0\u4fe1\u606f\"\n    **\u53d1\u5e03\u65f6\u95f4**: 2025-02-19\n    **\u6807\u7b7e**: \u6807\u7b7e1, \u6807\u7b7e2\n\n## \u5f15\u8a00\n\n\u7b80\u8981\u4ecb\u7ecd\u6587\u7ae0\u4e3b\u9898...\n\n## \u4e3b\u8981\u5185\u5bb9\n\n### \u7b2c\u4e00\u90e8\u5206\n\n\u5185\u5bb9...\n\n### \u7b2c\u4e8c\u90e8\u5206\n\n\u5185\u5bb9...\n\n## \u4ee3\u7801\u793a\u4f8b\n\n\\`\\`\\`python\n# \u793a\u4f8b\u4ee3\u7801\ndef example():\n    pass\n\\`\\`\\`\n\n## \u603b\u7ed3\n\n\u603b\u7ed3\u8981\u70b9...\n</code></pre>","tags":["mkdocs"]},{"location":"notes/how-to-use/#github-pages","title":"\u90e8\u7f72\u5230 GitHub Pages","text":"","tags":["mkdocs"]},{"location":"notes/how-to-use/#1-mkdocs","title":"\u65b9\u6cd5 1: \u4f7f\u7528 mkdocs \u547d\u4ee4","text":"<pre><code>mkdocs gh-deploy\n</code></pre> <p>\u8fd9\u4f1a\u81ea\u52a8\u6784\u5efa\u5e76\u63a8\u9001\u5230 <code>gh-pages</code> \u5206\u652f\u3002</p>","tags":["mkdocs"]},{"location":"notes/how-to-use/#2","title":"\u65b9\u6cd5 2: \u624b\u52a8\u6784\u5efa","text":"<pre><code>mkdocs build\n# \u7136\u540e\u5c06 site/ \u76ee\u5f55\u7684\u5185\u5bb9\u90e8\u7f72\u5230\u670d\u52a1\u5668\n</code></pre>","tags":["mkdocs"]},{"location":"notes/how-to-use/#_15","title":"\u6280\u672f\u6808","text":"<ul> <li>\u751f\u6210\u5668: MkDocs</li> <li>\u4e3b\u9898: Material for MkDocs</li> <li>\u63d2\u4ef6:</li> <li><code>search</code>: \u641c\u7d22\u529f\u80fd</li> <li><code>tags</code>: \u6807\u7b7e\u7cfb\u7edf</li> <li><code>macros</code>: \u52a8\u6001\u5185\u5bb9\u751f\u6210</li> <li>\u81ea\u5b9a\u4e49\u94a9\u5b50: <code>auto_nav_sort.py</code> - \u81ea\u52a8\u5bfc\u822a\u6392\u5e8f</li> </ul>","tags":["mkdocs"]},{"location":"notes/how-to-use/#_16","title":"\u6ce8\u610f\u4e8b\u9879","text":"<ol> <li>\u65e5\u671f\u683c\u5f0f: \u5fc5\u987b\u662f <code>YYYY-MM-DD</code>\uff0c\u5982 <code>2025-02-19</code></li> <li>\u6587\u4ef6\u7f16\u7801: \u4f7f\u7528 UTF-8 \u7f16\u7801</li> <li>\u56fe\u7247\u8def\u5f84: \u5efa\u8bae\u5c06\u56fe\u7247\u653e\u5728 <code>docs/images/</code> \u76ee\u5f55</li> <li>\u6784\u5efa\u8f93\u51fa: <code>site/</code> \u76ee\u5f55\u5df2\u52a0\u5165 <code>.gitignore</code>\uff0c\u4e0d\u4f1a\u88ab\u63d0\u4ea4</li> </ol>","tags":["mkdocs"]},{"location":"notes/how-to-use/#_17","title":"\u5e38\u89c1\u95ee\u9898","text":"","tags":["mkdocs"]},{"location":"notes/how-to-use/#q","title":"Q: \u6587\u7ae0\u6ca1\u6709\u51fa\u73b0\u5728\u5bfc\u822a\u4e2d\uff1f","tex